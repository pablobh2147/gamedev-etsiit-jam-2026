# ============================================================================
# .gitattributes - Configuración base para ETSIIT Game Jam 2026
# Evita conflictos de saltos de línea (CRLF vs LF) entre Windows, Linux y macOS
# y protege los archivos binarios de motores como Unity, Godot y C++.
# ============================================================================

# Normalizar saltos de línea automáticamente en archivos de texto
* text=auto eol=lf

# Scripts específicos de cada sistema operativo
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

# Código fuente común
*.cs text diff=csharp
*.cpp text diff=cpp
*.cc text diff=cpp
*.cxx text diff=cpp
*.h text diff=cpp
*.hpp text diff=cpp
*.gd text
*.shader text
*.gdshader text
*.hlsl text
*.glsl text
*.json text
*.md text
*.txt text
*.xml text
*.yaml text
*.yml text

# Archivos de escena / recursos basados en texto (Unity y Godot)
# Nota: Evitad editar la misma escena dos personas a la vez.
*.unity text -delta
*.prefab text -delta
*.asset text -delta
*.mat text -delta
*.anim text -delta
*.controller text -delta
*.meta text
*.tscn text
*.tres text
*.godot text
*.import text

# Proyectos de Visual Studio / CMake
*.sln text eol=crlf
*.csproj text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
CMakeLists.txt text eol=lf
*.cmake text eol=lf

